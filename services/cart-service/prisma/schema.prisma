generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CART_DATABASE_URL")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int
  createdAt DateTime @default(now())
  state     String
}

model CartProduct {
  id        Int     @id @default(autoincrement())
  cartId    Int
  productId Int
  amount    Int
}

model Period {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  duration_days Int
  bundles       Bundle[]
}

model Bundle {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String
  recurrenceId Int
  recurrence   Period   @relation(fields: [recurrenceId], references: [id])
  createdAt    DateTime @default(now())
}

model BundleProduct {
  id        Int     @id @default(autoincrement())
  bundleId  Int
  productId Int
  amount    Int
}


